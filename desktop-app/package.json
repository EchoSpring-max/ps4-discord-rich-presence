{
  "name": "ps4-discord-tracker",
  "version": "1.0.0",
  "description": "Desktop app to track PS4 games and update Discord Rich Presence.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win portable"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "psn-api": "^2.18.0"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.echospring.ps4discordtracker",
    "productName": "PS4 Discord Tracker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "assets/**/*",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
